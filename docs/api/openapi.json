      },
      "post": {
        "summary": "Registra manualmente un evento de merma",
        "tags": [
          "Registros"
        ],
        "description": "Valida el material y el motivo contra el catálogo, calcula la semana ISO, el valor unitario y el costo total con las mismas reglas del ETL, y deja una carga de auditoría con el evento. Solo pide la cabecera x-admin-token si la API define ADMIN_TOKEN.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "fecha",
                  "codigo_material",
                  "cantidad",
                  "motivo"
                ],
                "properties": {
                  "fecha": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "examples": [
                      "2026-11-25"
                    ]
                  },
                  "codigo_material": {
                    "type": "integer",
                    "minimum": 1,
                    "examples": [
                      10012345
                    ]
                  },
                  "cantidad": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "examples": [
                      "12.5"
                    ]
                  },
                  "motivo": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120,
                    "examples": [
                      "ROTURA DE EMBALAJES"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
