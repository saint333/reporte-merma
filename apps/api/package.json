{
  "name": "@merma/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:migrate": "tsx scripts/migrate.ts",
    "db:check": "tsx scripts/check-schema.ts",
    "etl": "tsx src/etl/cli.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "lru-cache": "^11.5.3",
    "pg": "^8.23.1",
    "postgres-migrations": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.1.2"
  }
}
