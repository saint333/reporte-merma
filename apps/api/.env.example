# Postgres local de docker-compose.yml
DATABASE_URL=postgresql://merma:merma@localhost:5432/merma

# API
PORT=8000
CORS_ORIGINS=http://localhost:5173
APP_ENV=development
CACHE_TTL_SECONDS=60
RATE_LIMIT_MAX=600

# Carga del Excel desde la web. Vacío = carga sin clave (por defecto).
# Si se define (mínimo 16 caracteres), la API exige la cabecera x-admin-token.
ADMIN_TOKEN=
UPLOAD_MAX_MB=20
